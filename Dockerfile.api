# ============================================================================
# MisebanAI API Server — Docker Image
# Multi-stage build: Rust 1.94 + YOLOv8n ONNX → minimal runtime
# ============================================================================

# Stage 1: Build
FROM rust:1.94-slim-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev curl libstdc++-12-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/

# Build the API binary with real ONNX inference
RUN cargo build --locked --release --package api

# Stage 2: Runtime
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/api /usr/local/bin/miseban-api
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && mkdir -p /models

ENV PORT=3000
ENV RUST_LOG=info
ENV MISEBAN_MODEL_PATH=/models/yolov8n.onnx
EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
